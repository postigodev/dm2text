---
import { CHROME_WEB_STORE_URL, IS_MANUAL_INSTALL } from '../config';
---

<div class="chrome-cta">
  <a class="primary" href={CHROME_WEB_STORE_URL}
    ><img
      src="/brand/google-chrome.svg"
      alt=""
      width="18"
      height="18"
      aria-hidden="true"
    />Add to Chrome</a
  >
  {IS_MANUAL_INSTALL && <span>Manual install via GitHub</span>}
</div>
