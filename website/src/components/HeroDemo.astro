<div class="demo" data-dm2text-demo>
  <div class="windowbar">
    <div class="traffic" aria-hidden="true"><i></i><i></i><i></i></div>
    <strong>DM2Text</strong><span></span>
  </div>

  <div class="demo-body">
    <section class="ig-chat" aria-label="Interactive Instagram Direct demo">
      <header class="ig-header">
        <div class="profile">
          <span class="avatar" aria-hidden="true">A</span>
          <span class="profile-copy">
            <strong>alex</strong>
            <small>Alex</small>
          </span>
        </div>
        <div class="ig-header-actions" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path d="M6.7 2.6c.7-.5 1.6-.4 2.2.2 1.4 1.5 2.5 3.2 3.1 5.1.2.6.1 1.2-.2 1.7l-.7 1.2c-.2.3-.1.7.1.9a9.6 9.6 0 0 0 3.1 3.1c.3.2.6.2.9.1l1.2-.7c.5-.3 1.1-.4 1.7-.2 1.9.6 3.6 1.7 5.1 3.1.6.6.7 1.5.2 2.2a12 12 0 0 1-1.5 1.7c-.5.5-1.2.8-1.9.8-4.7.1-8.7-3.2-11.1-5.6C6.5 13.8 3.2 9.8 3.3 5.1c0-.7.3-1.4.8-1.9.8-.7 1.6-1.3 2.6-1.8Z" />
          </svg>
          <svg viewBox="0 0 24 24" width="22" height="22">
            <rect x="2" y="4" width="15" height="16" rx="3"></rect>
            <path d="m17 9 4-3v12l-4-3"></path>
          </svg>
          <svg viewBox="0 0 24 24" width="22" height="22">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 11v6M12 7.4h.01"></path>
          </svg>
        </div>
      </header>

      <div class="ig-messages">
        <div class="day-divider">Tuesday · 10:41 AM</div>

        <div class="message-row incoming" data-demo-message data-transcript="[10:41 AM, Tuesday] Alex: did you see the draft?">
          <span class="mini-avatar" aria-hidden="true">A</span>
          <div class="bubble">did you see the draft?</div>
        </div>

        <div class="message-row outgoing" data-demo-message data-transcript="You: yep">
          <div class="bubble">yep</div>
        </div>

        <div class="message-row incoming" data-demo-message data-transcript="Alex: are you free now?">
          <span class="mini-avatar" aria-hidden="true">A</span>
          <div class="bubble">are you free now?</div>
        </div>

        <div class="message-row outgoing" data-demo-message data-transcript="You (replying to Alex: are you free now?): i'm at the office">
          <div class="bubble reply-bubble">
            <span class="reply-preview"><strong>alex</strong>are you free now?</span>
            i'm at the office
          </div>
        </div>

        <div class="message-row incoming" data-demo-message data-transcript="Alex: sounds good">
          <span class="mini-avatar" aria-hidden="true">A</span>
          <div class="bubble">sounds good</div>
        </div>

        <div class="message-row outgoing anchor-row" data-demo-message data-transcript="[10:44 AM, Tuesday] You: sorry!">
          <button
            class="message-menu-trigger"
            type="button"
            aria-label="Open message actions"
            aria-expanded="true"
            data-menu-trigger
          >•••</button>
          <div class="bubble">sorry!</div>
          <div class="message-menu" data-message-menu>
            <button type="button" data-copy-context>Copy context</button>
            <button type="button">Unsend</button>
          </div>
        </div>
      </div>

      <div class="composer" aria-hidden="true">
        <span class="composer-face">☺</span>
        <span class="composer-placeholder">Message...</span>
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 2a4 4 0 0 0-4 4v6a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4Z"></path><path d="M5 11v1a7 7 0 0 0 14 0v-1M12 19v3"></path></svg>
        <svg viewBox="0 0 24 24" width="20" height="20"><rect x="3" y="4" width="18" height="16" rx="3"></rect><circle cx="9" cy="10" r="2"></circle><path d="m5 18 5-5 3 3 2-2 4 4"></path></svg>
        <span class="heart">♡</span>
      </div>

      <div class="demo-scrim" data-dialog-scrim hidden>
        <section class="copy-dialog" role="dialog" aria-modal="true" aria-labelledby="hero-copy-title">
          <header class="dialog-header">
            <div>
              <h2 id="hero-copy-title">Copy context</h2>
              <p>Ends at the selected message</p>
            </div>
            <span class="anchor-glyph" aria-hidden="true">⌁</span>
          </header>
          <div class="context-progress" aria-hidden="true">
            <i></i><span></span><i class="active"></i>
          </div>
          <label class="count-label">
            Messages to include
            <input type="number" min="1" max="6" step="1" value="6" inputmode="numeric" data-count-input />
          </label>
          <p class="dialog-error" data-dialog-error aria-live="polite"></p>
          <div class="dialog-actions">
            <button type="button" class="cancel" data-dialog-cancel>Cancel</button>
            <button type="button" class="copy" data-dialog-copy>Copy</button>
          </div>
        </section>
      </div>

      <div class="demo-toast" role="status" data-demo-toast hidden>Transcript ready</div>
    </section>

    <section class="demo-transcript" aria-label="Generated plain-text transcript">
      <header class="transcript-head">
        <span>clipboard.txt</span><span>plain text</span>
      </header>
      <div class="transcript-empty" data-transcript-empty>
        <span class="cursor-mark">|</span>
        <p>Choose <strong>Copy context</strong> in the chat to generate the transcript.</p>
      </div>
      <pre data-transcript-output hidden></pre>
    </section>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('[data-dm2text-demo]').forEach((demo) => {
    const menuTrigger = demo.querySelector('[data-menu-trigger]');
    const menu = demo.querySelector('[data-message-menu]');
    const copyContext = demo.querySelector('[data-copy-context]');
    const scrim = demo.querySelector('[data-dialog-scrim]');
    const countInput = demo.querySelector('[data-count-input]');
    const cancel = demo.querySelector('[data-dialog-cancel]');
    const copy = demo.querySelector('[data-dialog-copy]');
    const error = demo.querySelector('[data-dialog-error]');
    const empty = demo.querySelector('[data-transcript-empty]');
    const output = demo.querySelector('[data-transcript-output]');
    const toast = demo.querySelector('[data-demo-toast]');
    const messages = [...demo.querySelectorAll('[data-demo-message]')];

    if (
      !menuTrigger ||
      !menu ||
      !copyContext ||
      !scrim ||
      !countInput ||
      !cancel ||
      !copy ||
      !error ||
      !empty ||
      !output ||
      !toast
    ) return;

    const setMenu = (open) => {
      menu.hidden = !open;
      menuTrigger.setAttribute('aria-expanded', String(open));
    };

    const setDialog = (open) => {
      scrim.hidden = !open;
      if (open) {
        error.textContent = '';
        countInput.focus();
        countInput.select();
      }
    };

    menuTrigger.addEventListener('click', () => {
      setMenu(menu.hidden);
    });

    copyContext.addEventListener('click', () => {
      setMenu(false);
      setDialog(true);
    });

    cancel.addEventListener('click', () => {
      setDialog(false);
      setMenu(true);
    });

    copy.addEventListener('click', () => {
      const requested = Number(countInput.value);
      if (!Number.isInteger(requested) || requested < 1 || requested > messages.length) {
        error.textContent = `Enter a whole number from 1 to ${messages.length}.`;
        return;
      }

      const transcript = messages
        .slice(-requested)
        .map((message) => message.getAttribute('data-transcript'))
        .filter(Boolean)
        .join('\n\n');

      output.textContent = transcript;
      output.hidden = false;
      empty.hidden = true;
      setDialog(false);
      toast.hidden = false;
      window.setTimeout(() => {
        toast.hidden = true;
      }, 1800);
    });

    scrim.addEventListener('click', (event) => {
      if (event.target === scrim) setDialog(false);
    });

    demo.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setDialog(false);
      setMenu(false);
    });
  });
</script>

