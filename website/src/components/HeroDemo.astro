---
const PROFILE = {
  name: 'Clara Z.',
  username: 'clara.zk',
  avatar:
    'https://images.unsplash.com/photo-1657749286412-811e2515563d?auto=format&fit=crop&q=82&w=160&h=160',
};

const MEDIA = {
  desk:
    'https://images.unsplash.com/photo-1781213983314-037deccf30a7?auto=format&fit=crop&q=78&w=720',
  keyboard:
    'https://images.unsplash.com/photo-1781120199906-9ebcb5644407?auto=format&fit=crop&q=78&w=720',
};

const claraLines = [
  'did you see the draft?',
  'are you free now?',
  'i moved the notes into the doc',
  'wait this is actually much better',
  'the spacing was bothering me',
  'can you send the latest version?',
  'i think the smaller type works',
  'that transition is weird on mobile',
  'okay yeah keep that',
  'you are overthinking the icon',
  'give me five minutes',
  'the second option reads cleaner',
  'i sent you the screenshots',
  'this one feels less like a landing page',
  'the copy is finally normal lol',
  'can we keep the weird little detail?',
  'i checked it on my phone',
  'the menu is way clearer now',
  'ship it before we change our minds',
  'wait one more thing',
];

const youLines = [
  'yep',
  "i'm at the office",
  'looking now',
  'fixed it',
  'that was the plan',
  'sending',
  'yeah i see it',
  'i can make it smaller',
  'done',
  'lmao okay',
  'one sec',
  'that is what i thought too',
  'got them',
  'thank god',
  'agreed',
  'absolutely not deleting that',
  'works here too',
  'nice',
  'fine we ship',
  'what',
];

const days = ['Monday', 'Tuesday', 'Wednesday'];
const messages = Array.from({ length: 126 }, (_, index) => {
  const from = index % 2 === 0 ? 'them' : 'you';
  const dayIndex = Math.min(days.length - 1, Math.floor(index / 42));
  const dayOffset = index % 42;
  const rawHour = 9 + Math.floor(dayOffset / 7);
  const displayHour = rawHour > 12 ? rawHour - 12 : rawHour;
  const minute = (dayOffset * 7) % 60;
  const timestamp =
    index % 7 === 0
      ? {
          time: `${displayHour}:${String(minute).padStart(2, '0')} ${rawHour < 12 ? 'AM' : 'PM'}`,
          date: dayOffset === 0 ? days[dayIndex] : undefined,
        }
      : undefined;

  const isPhoto = index > 5 && index % 17 === 8;
  const isReel = index > 8 && index % 23 === 11;
  const linePool = from === 'them' ? claraLines : youLines;
  const text = linePool[(index * 7 + Math.floor(index / 4)) % linePool.length];
  const previousPool = from === 'them' ? youLines : claraLines;
  const reply =
    index > 2 && index % 19 === 7
      ? {
          sender: from === 'them' ? 'You' : PROFILE.name,
          preview:
            previousPool[((index - 1) * 7 + Math.floor((index - 1) / 4)) % previousPool.length],
        }
      : undefined;

  if (isReel) {
    return {
      key: `demo-${index + 1}`,
      from,
      timestamp,
      reply,
      content: {
        type: 'shared-post' as const,
        source: index % 46 === 11 ? 'theory.after.dark' : 'small.web.club',
        caption:
          index % 46 === 11
            ? 'the point is to change it, apparently'
            : 'interfaces should explain themselves',
      },
      visual: { type: 'reel' as const, image: MEDIA.keyboard },
    };
  }

  if (isPhoto) {
    return {
      key: `demo-${index + 1}`,
      from,
      timestamp,
      reply,
      content: { type: 'media' as const, label: 'photo' },
      visual: { type: 'photo' as const, image: MEDIA.desk },
    };
  }

  return {
    key: `demo-${index + 1}`,
    from,
    timestamp,
    reply,
    content: { type: 'text' as const, text },
    visual: { type: 'text' as const, text },
  };
});

const initialAnchorKey = messages.at(-1)?.key;
---

<div class="demo" data-dm2text-demo data-message-count={messages.length}>
  <div class="windowbar">
    <div class="traffic" aria-hidden="true"><i></i><i></i><i></i></div>
    <strong>DM2Text</strong><span></span>
  </div>

  <div class="demo-body">
    <section class="ig-chat" aria-label="Interactive Instagram Direct demo">
      <header class="ig-header">
        <div class="profile">
          <img class="avatar" src={PROFILE.avatar} alt="" width="44" height="44" />
          <span class="profile-copy">
            <strong>{PROFILE.username}</strong>
            <small>{PROFILE.name}</small>
          </span>
        </div>

        <div class="ig-header-actions" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path
              d="M6.7 2.6c.7-.5 1.6-.4 2.2.2 1.4 1.5 2.5 3.2 3.1 5.1.2.6.1 1.2-.2 1.7l-.7 1.2c-.2.3-.1.7.1.9a9.6 9.6 0 0 0 3.1 3.1c.3.2.6.2.9.1l1.2-.7c.5-.3 1.1-.4 1.7-.2 1.9.6 3.6 1.7 5.1 3.1.6.6.7 1.5.2 2.2a12 12 0 0 1-1.5 1.7c-.5.5-1.2.8-1.9.8-4.7.1-8.7-3.2-11.1-5.6C6.5 13.8 3.2 9.8 3.3 5.1c0-.7.3-1.4.8-1.9.8-.7 1.6-1.3 2.6-1.8Z"
            />
          </svg>
          <svg viewBox="0 0 24 24" width="22" height="22">
            <rect x="2" y="4" width="15" height="16" rx="3"></rect>
            <path d="m17 9 4-3v12l-4-3"></path>
          </svg>
          <svg viewBox="0 0 24 24" width="22" height="22">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 11v6M12 7.4h.01"></path>
          </svg>
        </div>
      </header>

      <div class="ig-messages" data-message-scroller>
        {
          messages.map((message, index) => {
            const incoming = message.from === 'them';
            const sender = incoming ? PROFILE.name : 'You';
            const isInitialAnchor = message.key === initialAnchorKey;

            return (
              <>
                {message.timestamp?.date && (
                  <div class="day-divider">{message.timestamp.date}</div>
                )}
                {message.timestamp?.time && (
                  <div class="time-divider">{message.timestamp.time}</div>
                )}

                <div
                  class:list={[
                    'message-row',
                    incoming ? 'incoming' : 'outgoing',
                    isInitialAnchor && 'anchor-row',
                  ]}
                  data-demo-message
                  data-key={message.key}
                  data-sender={sender}
                  data-time={message.timestamp?.time}
                  data-date={message.timestamp?.date}
                  data-content-type={message.content.type}
                  data-text={
                    message.content.type === 'text'
                      ? message.content.text
                      : undefined
                  }
                  data-label={
                    message.content.type === 'media'
                      ? message.content.label
                      : undefined
                  }
                  data-source={
                    message.content.type === 'shared-post'
                      ? message.content.source
                      : undefined
                  }
                  data-caption={
                    message.content.type === 'shared-post'
                      ? message.content.caption
                      : undefined
                  }
                  data-reply-sender={message.reply?.sender}
                  data-reply-preview={message.reply?.preview}
                >
                  {incoming && (
                    <img
                      class="mini-avatar"
                      src={PROFILE.avatar}
                      alt=""
                      width="28"
                      height="28"
                      loading="lazy"
                    />
                  )}

                  <button
                    class="message-menu-trigger"
                    type="button"
                    aria-label={`Open actions for message ${index + 1}`}
                    aria-expanded={String(isInitialAnchor)}
                    data-menu-trigger
                  >
                    •••
                  </button>

                  {message.visual.type === 'text' && (
                    <div class:list={['bubble', message.reply && 'reply-bubble']}>
                      {message.reply && (
                        <span class="reply-preview">
                          <strong>{message.reply.sender}</strong>
                          {message.reply.preview}
                        </span>
                      )}
                      {message.visual.text}
                    </div>
                  )}

                  {message.visual.type !== 'text' && (
                    <div class:list={['media-card', message.visual.type === 'reel' && 'reel-card']}>
                      <img
                        src={message.visual.image}
                        alt={message.visual.type === 'reel' ? 'Shared reel preview' : 'Shared photo'}
                        loading="lazy"
                      />
                      {message.visual.type === 'reel' && (
                        <>
                          <span class="reel-play" aria-hidden="true">▶</span>
                          <span class="reel-tag">Reel</span>
                        </>
                      )}
                    </div>
                  )}

                  <div
                    class="message-menu"
                    data-message-menu
                    hidden={!isInitialAnchor}
                  >
                    <button type="button" data-copy-context>
                      <svg
                        data-dm2text-icon
                        aria-hidden="true"
                        focusable="false"
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="8" y="7" width="10" height="12" rx="2"></rect>
                        <path d="M6 17H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"></path>
                      </svg>
                      <span>Copy context</span>
                    </button>
                    <button type="button" data-unsend>
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"></path>
                      </svg>
                      <span>Unsend</span>
                    </button>
                  </div>
                </div>
              </>
            );
          })
        }
      </div>

      <form class="composer" data-composer>
        <button class="composer-face" type="button" aria-label="Emoji">☺</button>
        <input
          class="composer-input"
          type="text"
          autocomplete="off"
          placeholder="Message..."
          aria-label="Write a demo message"
          data-message-input
        />
        <button class="composer-tool" type="button" aria-label="Add demo photo" title="Add photo" data-add-photo>
          <svg viewBox="0 0 24 24" width="20" height="20">
            <rect x="3" y="4" width="18" height="16" rx="3"></rect>
            <circle cx="9" cy="10" r="2"></circle>
            <path d="m5 18 5-5 3 3 2-2 4 4"></path>
          </svg>
        </button>
        <button class="composer-tool" type="button" aria-label="Add demo reel" title="Add reel" data-add-reel>
          <svg viewBox="0 0 24 24" width="20" height="20">
            <rect x="3" y="3" width="18" height="18" rx="4"></rect>
            <path d="m8 3 3 5M14 3l3 5M3 9h18"></path>
            <path d="m10 13 5 3-5 3Z"></path>
          </svg>
        </button>
        <button class="send-button" type="submit">Send</button>
      </form>

      <div class="demo-scrim" data-dialog-scrim hidden>
        <section
          class="copy-dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="hero-copy-title"
        >
          <header class="dialog-header">
            <div>
              <h2 id="hero-copy-title">Copy context</h2>
              <p>Ends at the selected message</p>
            </div>
            <span class="anchor-glyph" aria-hidden="true">⌁</span>
          </header>

          <div class="context-progress" aria-hidden="true">
            <i></i><span></span><i class="active"></i>
          </div>

          <label class="count-label">
            Messages to include
            <input
              type="number"
              min="1"
              max="999"
              step="1"
              value="25"
              inputmode="numeric"
              data-count-input
            />
          </label>

          <p class="dialog-hint" data-dialog-hint></p>
          <p class="dialog-error" data-dialog-error aria-live="polite"></p>

          <div class="dialog-actions">
            <button type="button" class="cancel" data-dialog-cancel>Cancel</button>
            <button type="button" class="copy" data-dialog-copy>Copy</button>
          </div>
        </section>
      </div>

      <div class="demo-toast" role="status" data-demo-toast hidden></div>
    </section>

    <section class="demo-transcript" aria-label="Paste copied transcript">
      <header class="transcript-head">
        <span>pasteboard.txt</span><span>plain text</span>
      </header>

      <textarea
        data-paste-zone
        spellcheck="false"
        aria-label="Paste the copied DM2Text transcript here"
        placeholder="Copy context on the left, then paste here.&#10;&#10;Ctrl+V / ⌘V"
      ></textarea>

      <footer class="paste-status" data-paste-status>
        Nothing is inserted here automatically.
      </footer>
    </section>
  </div>
</div>

<script is:inline define:vars={{ profileName: PROFILE.name, profileAvatar: PROFILE.avatar, mediaDesk: MEDIA.desk, mediaKeyboard: MEDIA.keyboard }}>
  document.querySelectorAll('[data-dm2text-demo]').forEach((demo) => {
    const scroller = demo.querySelector('[data-message-scroller]');
    const scrim = demo.querySelector('[data-dialog-scrim]');
    const countInput = demo.querySelector('[data-count-input]');
    const cancel = demo.querySelector('[data-dialog-cancel]');
    const copy = demo.querySelector('[data-dialog-copy]');
    const error = demo.querySelector('[data-dialog-error]');
    const hint = demo.querySelector('[data-dialog-hint]');
    const toast = demo.querySelector('[data-demo-toast]');
    const pasteZone = demo.querySelector('[data-paste-zone]');
    const pasteStatus = demo.querySelector('[data-paste-status]');
    const composer = demo.querySelector('[data-composer]');
    const messageInput = demo.querySelector('[data-message-input]');
    const addPhoto = demo.querySelector('[data-add-photo]');
    const addReel = demo.querySelector('[data-add-reel]');

    if (
      !scroller ||
      !scrim ||
      !countInput ||
      !cancel ||
      !copy ||
      !error ||
      !hint ||
      !toast ||
      !pasteZone ||
      !pasteStatus ||
      !composer ||
      !messageInput ||
      !addPhoto ||
      !addReel
    ) return;

    let anchorRow = demo.querySelector('.anchor-row');
    let toastTimer = 0;
    let dynamicKey = 1;

    const getMessages = () => [...scroller.querySelectorAll('[data-demo-message]')];

    const closeMenus = (except) => {
      demo.querySelectorAll('[data-message-menu]').forEach((menu) => {
        if (menu === except) return;
        menu.hidden = true;
        const row = menu.closest('[data-demo-message]');
        row?.querySelector('[data-menu-trigger]')?.setAttribute('aria-expanded', 'false');
      });
    };

    const setDialog = (open) => {
      scrim.hidden = !open;
      if (!open) return;
      error.textContent = '';

      const messages = getMessages();
      const anchorIndex = messages.indexOf(anchorRow);
      const available = Math.max(1, anchorIndex + 1);
      countInput.max = String(Math.min(999, available));
      countInput.value = String(Math.min(25, available));
      hint.textContent = `${available} messages available before this one.`;
      countInput.focus();
      countInput.select();
    };

    const showToast = (message) => {
      window.clearTimeout(toastTimer);
      toast.textContent = message;
      toast.hidden = false;
      toastTimer = window.setTimeout(() => {
        toast.hidden = true;
      }, 2200);
    };

    const normalizeInline = (value) => value.trim().replace(/\s+/gu, ' ');
    const normalizeMessageText = (value) =>
      value
        .replace(/\r\n?/gu, '\n')
        .split('\n')
        .map(normalizeInline)
        .filter(Boolean)
        .join('\\n');

    const formatTimestamp = (time, date) => {
      if (!time) return '';
      return date ? `[${time}, ${date}] ` : `[${time}] `;
    };

    const formatReply = (row) => {
      const preview = normalizeMessageText(row.dataset.replyPreview || '');
      if (!preview) return '';
      const sender = normalizeInline(row.dataset.replySender || '');
      const context = sender ? `${sender}: ${preview}` : preview;
      return ` (replying to ${context})`;
    };

    const formatContent = (row) => {
      const type = row.dataset.contentType;
      if (type === 'shared-post') {
        const source = normalizeInline(row.dataset.source || '');
        const caption = normalizeMessageText(row.dataset.caption || '');
        const header = source ? `[shared post by ${source}]` : '[shared post]';
        return caption ? `${header}\n  Caption: ${caption}` : header;
      }

      if (type === 'text') {
        return normalizeMessageText(row.dataset.text || '');
      }

      const label = normalizeInline(row.dataset.label || '') || 'media';
      if (type === 'media') return `[${label}]`;

      const text = normalizeMessageText(row.dataset.text || '');
      return text ? `${text} [${label}]` : `[${label}]`;
    };

    const formatTranscript = (rows) => {
      let activeDate;

      return rows
        .map((row) => {
          const explicitDate = normalizeInline(row.dataset.date || '');
          if (explicitDate) activeDate = explicitDate;

          const time = normalizeInline(row.dataset.time || '');
          const timestamp = formatTimestamp(time, activeDate);
          const sender = normalizeInline(row.dataset.sender || '') || 'Unknown';
          const reply = formatReply(row);
          const content = formatContent(row);
          return `${timestamp}${sender}${reply}: ${content}`;
        })
        .join('\n');
    };

    const selectEndingAt = (rows, anchor, count) => {
      const anchorIndex = rows.indexOf(anchor);
      if (anchorIndex < 0) return [];
      const normalizedCount = Number.isFinite(count)
        ? Math.max(1, Math.floor(count))
        : 1;
      const startIndex = Math.max(0, anchorIndex - normalizedCount + 1);
      return rows.slice(startIndex, anchorIndex + 1);
    };

    const copyText = async (text) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }

      const fallback = document.createElement('textarea');
      fallback.value = text;
      fallback.setAttribute('readonly', '');
      fallback.style.position = 'fixed';
      fallback.style.opacity = '0';
      document.body.append(fallback);
      fallback.select();
      const copied = document.execCommand('copy');
      fallback.remove();
      if (!copied) throw new Error('Copy command failed');
    };

    const buildMenu = () => {
      const menu = document.createElement('div');
      menu.className = 'message-menu';
      menu.hidden = true;
      menu.setAttribute('data-message-menu', '');
      menu.innerHTML = `
        <button type="button" data-copy-context>
          <svg data-dm2text-icon aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="7" width="10" height="12" rx="2"></rect>
            <path d="M6 17H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copy context</span>
        </button>
        <button type="button" data-unsend>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"></path>
          </svg>
          <span>Unsend</span>
        </button>
      `;
      return menu;
    };

    const appendOutgoing = ({ type, text = '', label = '', image = '' }) => {
      const row = document.createElement('div');
      row.className = 'message-row outgoing';
      row.setAttribute('data-demo-message', '');
      row.dataset.key = `user-${dynamicKey++}`;
      row.dataset.sender = 'You';
      row.dataset.contentType = type;

      if (type === 'text') row.dataset.text = text;
      if (type === 'media') row.dataset.label = label;
      if (type === 'shared-post') {
        row.dataset.source = 'you';
        row.dataset.caption = 'shared from the demo';
      }

      const trigger = document.createElement('button');
      trigger.className = 'message-menu-trigger';
      trigger.type = 'button';
      trigger.setAttribute('aria-label', 'Open actions for new message');
      trigger.setAttribute('aria-expanded', 'false');
      trigger.setAttribute('data-menu-trigger', '');
      trigger.textContent = '•••';
      row.append(trigger);

      if (type === 'text') {
        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        bubble.textContent = text;
        row.append(bubble);
      } else {
        const card = document.createElement('div');
        card.className = type === 'shared-post' ? 'media-card reel-card' : 'media-card';
        const img = document.createElement('img');
        img.src = image;
        img.alt = type === 'shared-post' ? 'Shared reel preview' : 'Shared photo';
        card.append(img);

        if (type === 'shared-post') {
          const play = document.createElement('span');
          play.className = 'reel-play';
          play.setAttribute('aria-hidden', 'true');
          play.textContent = '▶';
          const tag = document.createElement('span');
          tag.className = 'reel-tag';
          tag.textContent = 'Reel';
          card.append(play, tag);
        }

        row.append(card);
      }

      row.append(buildMenu());
      scroller.append(row);
      scroller.scrollTop = scroller.scrollHeight;
      showToast('Message added to the demo');
    };

    demo.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest('[data-menu-trigger]');
      if (trigger) {
        const row = trigger.closest('[data-demo-message]');
        const menu = row?.querySelector('[data-message-menu]');
        if (!row || !menu) return;
        const shouldOpen = menu.hidden;
        closeMenus(menu);
        menu.hidden = !shouldOpen;
        trigger.setAttribute('aria-expanded', String(shouldOpen));
        anchorRow = row;
        return;
      }

      const copyContext = target.closest('[data-copy-context]');
      if (copyContext) {
        const row = copyContext.closest('[data-demo-message]');
        if (!row) return;
        anchorRow = row;
        closeMenus();
        setDialog(true);
        return;
      }

      const unsend = target.closest('[data-unsend]');
      if (unsend) {
        const row = unsend.closest('[data-demo-message]');
        if (!row) return;
        const wasAnchor = row === anchorRow;
        row.remove();

        const messages = getMessages();
        if (wasAnchor) anchorRow = messages.at(-1) || null;
        showToast('Message removed — it will not be copied');
      }
    });

    cancel.addEventListener('click', () => {
      setDialog(false);
    });

    copy.addEventListener('click', async () => {
      const requested = Number(countInput.value);
      const max = Number(countInput.max);
      if (!Number.isInteger(requested) || requested < 1 || requested > max) {
        error.textContent = `Enter a whole number from 1 to ${max}.`;
        return;
      }

      const rows = getMessages();
      const selected = selectEndingAt(rows, anchorRow, requested);
      const transcript = formatTranscript(selected);

      try {
        await copyText(transcript);
        setDialog(false);
        pasteZone.focus();
        showToast(`Copied ${selected.length} messages — paste on the right`);
      } catch {
        error.textContent = 'Clipboard access failed. Try again in a secure browser context.';
      }
    });

    composer.addEventListener('submit', (event) => {
      event.preventDefault();
      const text = messageInput.value.trim();
      if (!text) return;
      appendOutgoing({ type: 'text', text });
      messageInput.value = '';
      messageInput.focus();
    });

    addPhoto.addEventListener('click', () => {
      appendOutgoing({
        type: 'media',
        label: 'photo',
        image: mediaDesk,
      });
    });

    addReel.addEventListener('click', () => {
      appendOutgoing({
        type: 'shared-post',
        image: mediaKeyboard,
      });
    });

    pasteZone.addEventListener('input', () => {
      const value = pasteZone.value.trim();
      pasteStatus.textContent = value
        ? `${value.split(/\n/u).filter(Boolean).length} transcript lines pasted.`
        : 'Nothing is inserted here automatically.';
    });

    scrim.addEventListener('click', (event) => {
      if (event.target === scrim) setDialog(false);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || demo.contains(target)) return;
      closeMenus();
    });

    demo.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setDialog(false);
      closeMenus();
    });

    scroller.scrollTop = scroller.scrollHeight;
  });
</script>

